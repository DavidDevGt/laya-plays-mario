# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environment (recreate with: python3 -m venv .venv && pip install -r requirements.txt)
.venv/
venv/

# Editor / assistant session state (not project content)
.claude/

# Model weights -- too large for git (each exceeds GitHub's 100MB per-file limit).
# The base checkpoint is downloaded via huggingface-cli (see README.md); the Mario
# fine-tuned checkpoints are regenerated via models/laya/mario/finetune.py using the
# committed dataset + configs (see models/laya/mario/FINAL_REPORT.md section 4/8).
**/model.safetensors

# OS junk
.DS_Store
Thumbs.db

# Scratch output from the demo video-capture script (regenerated by capture_video.py)
models/laya/mario/demo/_capture_tmp/

# Videos and video previews -- generated artifacts, not source; regenerate with record.py /
# record_demo.py / capture_video.py (see README.md and FINAL_REPORT.md for exact commands).
*.mp4
**/*_preview.png
